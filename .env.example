# Bright Data token. Leave empty for free mode (direct fetching only). In HTTP mode clients may send their own.
API_TOKEN=

# Zones (created automatically unless AUTO_CREATE_ZONES=false)
WEB_UNLOCKER_ZONE=mcp_unlocker
BROWSER_ZONE=mcp_browser
AUTO_CREATE_ZONES=true

# Tool selection (default: all tools)
# GROUPS=scrapers,browser,advanced_scraping
# TOOLS=search_engine,scrape_as_markdown

# Spending guards (0 = unlimited)
BUDGET_MAX_REQUESTS=0
MAX_RECORDS_PER_RUN=200
# RATE_LIMIT=100/1h
PRICE_PER_1K=1.5

# Reliability
BASE_TIMEOUT=90
BASE_MAX_RETRIES=2
MAX_CONCURRENCY=5

# Caching and output size
CACHE_TTL=300
CACHE_MAX_ENTRIES=200
MAX_OUTPUT_CHARS=60000

# Security
CONTENT_GATE=on
CONTENT_GATE_TIMEOUT=120

# Browser
BROWSER_IDLE_TIMEOUT=300
MAX_BROWSER_SESSIONS=3
# BROWSER_CDP_ENDPOINT=ws://127.0.0.1:9222/devtools/browser/...

# HTTP transport
# MCP_TRANSPORT=http
# HOST=127.0.0.1
# PORT=3000
# HTTP_AUTH_SECRET=
# HTTP_SESSION_IDLE_TIMEOUT=1800

LOG_LEVEL=info

# Page fetching: auto (free direct first, Bright Data when blocked), direct (never billed), brightdata (always billed)
FETCH_STRATEGY=auto
DIRECT_TIMEOUT=15
DIRECT_MAX_BYTES=10000000
# DIRECT_USER_AGENT=
DIRECT_ALLOW_PRIVATE=false

# Local rendering of JavaScript-only pages in your installed Chrome/Edge (free)
LOCAL_RENDER=on
# CHROME_PATH=
LOCAL_RENDER_TIMEOUT=25
LOCAL_RENDER_ON=needs_javascript,empty
LOCAL_RENDER_IDLE=120
LOCAL_RENDER_CONCURRENCY=2
